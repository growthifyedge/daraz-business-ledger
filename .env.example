# =============================================================================
# Daraz Business Ledger — Environment Variables
# Copy this file to `.env` for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables for production.
# NEVER commit your real `.env` (it is git-ignored).
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (Supabase Free Plan — PostgreSQL)
# -----------------------------------------------------------------------------
# Supabase → Project → Settings → Database → "Connection string".
#DATABASE_URL=
# DATABASE_URL  = the POOLED connection (Transaction mode, port 6543) used by the
#                 app at runtime on Vercel's serverless functions. It MUST include
#                 ?pgbouncer=true&connection_limit=1
# DIRECT_URL    = the DIRECT connection (Session mode, port 5432) used only for
#                 schema migrations (`prisma db push` / `prisma migrate`).
#
# Replace [PASSWORD] with your database password and [PROJECT-REF]/[REGION]
# with the values Supabase shows you.
"postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# AUTH — session signing secret (REQUIRED)
# -----------------------------------------------------------------------------
# A long random string used to sign the login session JWT. Generate one with:
#   openssl rand -base64 48
# Use a DIFFERENT value in production than in local development.
AUTH_SECRET="replace-with-a-long-random-string"

# -----------------------------------------------------------------------------
# FILE UPLOADS (invoices / receipts) — Supabase Storage — OPTIONAL
# -----------------------------------------------------------------------------
# The app works fully without these; only invoice/receipt upload needs them.
# In Supabase → Storage, create a PUBLIC bucket named `uploads`. Then:
#   SUPABASE_URL              = Project → Settings → API → Project URL
#   SUPABASE_SERVICE_ROLE_KEY = Project → Settings → API → service_role key
#                               (SECRET — server-only, NEVER expose to the browser)
#   SUPABASE_STORAGE_BUCKET   = bucket name (defaults to "uploads" if omitted)
# If left empty, the upload button shows a friendly "storage not configured"
# message and every other feature keeps working.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="uploads"

# -----------------------------------------------------------------------------
# SEED ACCOUNTS — used ONLY by `npm run db:seed` (not needed at runtime)
# -----------------------------------------------------------------------------
# Set strong values BEFORE seeding, then change them from... (there is no in-app
# password UI yet, so choose the final passwords here). These are only read by
# the seed script, so they do NOT need to be added to Vercel.
OWNER_EMAIL="owner@example.com"
OWNER_PASSWORD="ChangeMe-Strong-Owner-Pw"
ADMIN_EMAIL="yahya@example.com"
ADMIN_PASSWORD="ChangeMe-Strong-Yahya-Pw"

# The Daraz import no longer accepts or stores any customer PII, so the former
# DARAZ_PII_KEY (customer-PII encryption key) is no longer used and has been
# removed. The importer accepts only a sanitized, identifier-only Orders dataset.
