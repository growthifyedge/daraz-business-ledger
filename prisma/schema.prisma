// Daraz Business Ledger & Inventory System — database schema
// PostgreSQL + Prisma. Works with Supabase, Neon, Railway, or any Postgres host.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
}

enum PaymentStatus {
  UNPAID
  PAID
  RECONCILIATION_PENDING // paid in reality but amount/date not yet reconciled; NOT owed, NOT a settled payment, no cash-flow impact
}

enum StockMovementType {
  ADD // stock received / added
  REDUCE // manual reduction
  ADJUST // manual correction
  TRANSFER // moved between stores
  DAMAGED
  LOST
  RETURNED
  SALE // auto from a sale entry
  PURCHASE // auto from a purchase entry
}

enum ExpenseCategory {
  PRODUCT_COST
  VAT
  DARAZ_COMMISSION
  OTHER_DARAZ_CHARGES
  PACKAGING
  FLYERS
  TAPE
  STICKERS
  SCISSORS
  STATIONERY
  BANK_CHARGES
  DELIVERY_TRANSPORT
  MISCELLANEOUS
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  RESTORE
  VIEW // e.g. an authorised reveal of masked customer PII (value never stored)
}

enum CashParty {
  YAHYA
  OWNER
}

// Who bears the cost of a return refund.
enum ReturnChargedTo {
  SELLER // deducted from seller (your cost)
  PLATFORM // absorbed by Daraz
  PENDING // not yet refunded / decided
}

// Where the refund itself stands. Only COMPLETED refunds are financial events.
enum ReturnRefundStatus {
  PENDING // raised, money not yet moved — never counted as a loss
  COMPLETED // refund settled
  CANCELLED // return withdrawn / refund refused — never a loss
}

// Where the physical unit stands. Drives every stock effect; a unit lives in
// exactly one bucket at a time.
enum ReturnInventoryStatus {
  NOT_RECEIVED // still with the buyer / in transit — no stock effect
  RECEIVED_PENDING_QC // back in hand, not yet inspected — returnedStock only
  RESTOCKED // passed QC, sellable again — currentStock via one RETURNED movement
  DAMAGED // failed QC — damagedStock only
  LOST // never arrived / lost in transit — lostStock only
}

// ---------------------------------------------------------------------------
// Auth / Users
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(ADMIN)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs AuditLog[]
}

// ---------------------------------------------------------------------------
// Stores
// ---------------------------------------------------------------------------

model Store {
  id        String    @id @default(cuid())
  name      String
  notes     String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete

  products    ProductStore[]
  purchases   Purchase[]
  sales       Sale[]
  expenses    Expense[]
  settlements Settlement[]
  movements   StockMovement[]
  returns     Return[]
}

// ---------------------------------------------------------------------------
// Products & Inventory
// ---------------------------------------------------------------------------

model Product {
  id            String    @id @default(cuid())
  name          String
  sku           String    @unique
  category      String    @default("Lifestyle Gadgets")
  purchaseCost  Float     @default(0) // cost per unit
  sellingPrice  Float     @default(0)
  currentStock  Int       @default(0)
  minStockLevel Int       @default(0)
  damagedStock  Int       @default(0)
  lostStock     Int       @default(0)
  returnedStock Int       @default(0)
  active        Boolean   @default(true)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  stores          ProductStore[]
  purchases       Purchase[]
  sales           Sale[]
  movements       StockMovement[]
  returns         Return[]
  DarazOrderItem  DarazOrderItem[]
  DarazSkuMapping DarazSkuMapping[]
}

// Join table: a product can be available in one or many stores.
model ProductStore {
  productId String
  storeId   String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([productId, storeId])
}

model StockMovement {
  id          String            @id @default(cuid())
  productId   String
  product     Product           @relation(fields: [productId], references: [id])
  storeId     String?
  store       Store?            @relation(fields: [storeId], references: [id])
  type        StockMovementType
  quantity    Int // signed effect on currentStock (+ received, - reduced)
  toStoreId   String? // for transfers
  reference   String? // e.g. related purchase/sale id
  note        String?
  createdById String?
  createdBy   String? // display name snapshot
  createdAt   DateTime          @default(now())

  @@index([productId])
  @@index([storeId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Purchases (Yahya buys, owner reimburses)
// ---------------------------------------------------------------------------

model Purchase {
  id                String        @id @default(cuid())
  date              DateTime
  purchasedBy       String        @default("Yahya")
  storeId           String?
  store             Store?        @relation(fields: [storeId], references: [id])
  productId         String
  product           Product       @relation(fields: [productId], references: [id])
  quantity          Int
  unitCost          Float
  totalCost         Float
  invoiceUrl        String?
  paymentStatus     PaymentStatus @default(UNPAID)
  reimbursementDate DateTime?
  bankReference     String?
  notes             String?
  createdById       String?
  createdBy         String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  @@index([date])
  @@index([productId])
  @@index([storeId])
}

// ---------------------------------------------------------------------------
// Sales income (manually entered from Daraz Seller App)
// ---------------------------------------------------------------------------

model Sale {
  id             String    @id @default(cuid())
  date           DateTime
  storeId        String?
  store          Store?    @relation(fields: [storeId], references: [id])
  productId      String
  product        Product   @relation(fields: [productId], references: [id])
  quantitySold   Int
  /// Per-unit cost captured AT SALE TIME. Snapshot so historical COGS stays
  /// stable when Product.purchaseCost later changes. Null on legacy rows, which
  /// fall back to Product.purchaseCost for backward compatibility only.
  unitCost       Float? // snapshot of cost/unit when the sale was recorded
  grossAmount    Float // gross sale amount
  commission     Float     @default(0) // Daraz commission
  vat            Float     @default(0)
  otherCharges   Float     @default(0) // other Daraz charges
  /// Legacy inline refund field. HISTORICAL ONLY — no longer writable from the
  /// Sales form: `saveSale` stores 0 on create and preserves the existing value
  /// on edit. Every new refund is recorded in the Returns module instead, which
  /// is what keeps the two sources from double-counting in P&L.
  returnsRefunds Float     @default(0)
  netAmount      Float // net received / settlement amount
  returns        Return[]
  notes          String?
  createdById    String?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([date])
  @@index([productId])
  @@index([storeId])
}

// ---------------------------------------------------------------------------
// Expenses
// ---------------------------------------------------------------------------

model Expense {
  id            String          @id @default(cuid())
  date          DateTime
  category      ExpenseCategory
  storeId       String?
  store         Store?          @relation(fields: [storeId], references: [id])
  amount        Float
  paidBy        String?
  paymentMethod String?
  receiptUrl    String?
  notes         String?
  createdById   String?
  createdBy     String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?

  @@index([date])
  @@index([storeId])
}

// ---------------------------------------------------------------------------
// Accessories & Stationery (packing material)
// ---------------------------------------------------------------------------

model Accessory {
  id                String    @id @default(cuid())
  name              String
  quantityPurchased Int       @default(0)
  quantityUsed      Int       @default(0)
  unitCost          Float     @default(0)
  totalCost         Float     @default(0)
  purchaseDate      DateTime?
  receiptUrl        String?
  notes             String?
  createdById       String?
  createdBy         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
}

// ---------------------------------------------------------------------------
// Weekly Daraz settlements
// ---------------------------------------------------------------------------

model Settlement {
  id            String    @id @default(cuid())
  date          DateTime
  storeId       String?
  store         Store?    @relation(fields: [storeId], references: [id])
  grossAmount   Float
  vat           Float     @default(0)
  commission    Float     @default(0)
  otherCharges  Float     @default(0)
  deductions    Float     @default(0) // any other lumped deductions
  netAmount     Float
  bankReference String?
  notes         String?
  createdById   String?
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([date])
  @@index([storeId])
}

// ---------------------------------------------------------------------------
// Returns & refunds (from Daraz Seller Center → Returns)
// ---------------------------------------------------------------------------

model Return {
  id            String    @id @default(cuid())
  returnDate    DateTime // when the return was raised — the financial reporting date
  orderDate     DateTime? // original order date
  orderNumber   String? // Daraz order number
  returnOrderId String? // Daraz Return Order ID (repeats across line items)
  returnItemId  String?   @unique // Daraz Return Item ID — line-level identity
  orderItemId   String? // Daraz Order Item ID — one per ordered unit
  receivedAt    DateTime? // when the unit was physically received back

  storeId   String?
  store     Store?   @relation(fields: [storeId], references: [id])
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  // Optional link back to the originating sale. Used to block double-counting
  // against the legacy Sale.returnsRefunds field.
  saleId    String?
  sale      Sale?    @relation(fields: [saleId], references: [id])

  buyerName    String?
  sellerSku    String? // Daraz seller SKU / variant
  quantity     Int     @default(1)
  /// Per-unit cost of the returned item, snapshotted when the return is saved.
  /// Used to recover COGS when the unit is RESTOCKED. Defaults from the linked
  /// Sale.unitCost (or Product.purchaseCost), then frozen — a later change to
  /// Product.purchaseCost never rewrites it.
  unitCost     Float? // snapshot of cost/unit for COGS recovery
  paidAmount   Float   @default(0) // paid price + shipping fee
  refundAmount Float   @default(0)

  chargedTo       ReturnChargedTo       @default(PENDING) // who bears the cost
  refundStatus    ReturnRefundStatus    @default(PENDING) // financial lifecycle
  inventoryStatus ReturnInventoryStatus @default(NOT_RECEIVED) // physical lifecycle

  reason         String?
  status         String? // raw Daraz status — informational only, drives no logic
  logisticStatus String? // raw Daraz logistic status — informational only
  trackingNumber String?

  /// @deprecated Superseded by `inventoryStatus`. Retained only for additive
  /// database compatibility with the already-deployed table. Application logic
  /// must never read or write it.
  restocked Boolean @default(false)

  notes       String?
  createdById String?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([returnOrderId, orderItemId])
  @@index([returnDate])
  @@index([productId])
  @@index([storeId])
  @@index([saleId])
  @@index([returnOrderId])
  @@index([refundStatus, chargedTo, deletedAt])
}

// ---------------------------------------------------------------------------
// Cash flow — owner investment and profit-share payouts
// ---------------------------------------------------------------------------

model Investment {
  id          String    @id @default(cuid())
  date        DateTime
  amount      Float
  note        String?
  createdById String?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([date])
}

// Profit-share payouts actually paid out to Yahya or the Owner.
model Payout {
  id          String    @id @default(cuid())
  date        DateTime
  party       CashParty
  amount      Float
  note        String?
  createdById String?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([date])
}

// ---------------------------------------------------------------------------
// Audit log — owner-only. Never deletable from the UI.
// ---------------------------------------------------------------------------

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id])
  userEmail String
  userName  String
  action    AuditAction
  module    String
  recordId  String?
  oldValue  Json?
  newValue  Json?
  createdAt DateTime    @default(now())

  @@index([createdAt])
  @@index([module])
}

// ===========================================================================
// Daraz Orders + Income Import module (additive; not yet pushed to production)
// ===========================================================================
// Nothing in the app writes to these models yet — the Import page is dry-run
// only. They define the persistent shape for when import is enabled.

/// Fee categories. Every Daraz fee keeps its ORIGINAL label in DarazIncomeFee.label;
/// this enum only groups it so P&L can keep commission / payment / shipping /
/// handling / vouchers / coins / the two withholding taxes / refunds / reversals
/// strictly separate. Never collapse these into a single "commission".
enum DarazFeeCategory {
  PRODUCT_REVENUE // Product Price Paid by Buyer
  BUYER_SHIPPING_CREDIT // Shipping Fee Paid by Buyer
  COMMISSION // Commission Fee (ONLY this)
  PAYMENT_FEE // Payment Fee
  SHIPPING_FEE // Shipping Fee (logistics charged to seller)
  FREE_SHIPPING_MAX_FEE // Free Shipping Max Fee
  HANDLING_FEE // Handling Fee
  COINS_PARTICIPATION // Daraz Coins Discount Participation Fee
  VOUCHER_PARTICIPATION // Co-funded Voucher Max
  SHIPPING_DISCOUNT // Shipping Fee Discount
  INCOME_TAX_WHT // Income Tax Withholding
  SALES_TAX_WHT // Sales Tax Withholding
  REFUND // *Refunded* fee lines
  REVERSAL // *Reversal of* fee lines
  OTHER // anything unrecognised — surfaced for review, never silently dropped
}

enum DarazImportStatus {
  DRY_RUN // previewed only, never written
  COMMITTED // reserved for when import is enabled
}

/// One upload session. `fingerprint` (hash of both files' content) makes
/// re-uploading identical files a no-op — idempotency at the batch level.
model DarazImportBatch {
  id               String            @id @default(cuid())
  fingerprint      String            @unique // sha256(ordersHash + incomeHash)
  ordersFileName   String
  ordersFileHash   String
  incomeFileName   String
  incomeFileHash   String
  status               DarazImportStatus @default(DRY_RUN)
  totalOrderItems      Int               @default(0)
  totalIncomeLines     Int               @default(0) // statement-specific lines (219)
  distinctOrderItemIds Int               @default(0) // distinct income Order Item IDs (215)
  matchedLines         Int               @default(0)
  unmatchedLines       Int               @default(0)
  duplicateLines       Int               @default(0)
  unresolvedSkus       Int               @default(0)
  statementCount       Int               @default(0)
  totalCredits         Float             @default(0)
  totalDeductions      Float             @default(0)
  netPayout            Float             @default(0)
  reconDiff            Float             @default(0)
  createdById          String?
  createdBy            String?
  createdAt            DateTime          @default(now())

  orderItems  DarazOrderItem[]
  incomeLines DarazIncomeLine[]

  @@index([createdAt])
}

/// Confidential customer identity. OWNER/ADMIN access only; phone and
/// nationalRegistrationNumber are masked in the UI by default and every
/// view/reveal/edit/export is audit-logged. Never logged, never in fixtures/Git.
model DarazCustomer {
  id String @id @default(cuid())
  // ---- All PII columns store AES-256-GCM CIPHERTEXT (lib/daraz/crypto), never
  // readable plaintext. Decryption is server-only, owner/admin, audit-logged.
  nameEnc                    String? // encrypted
  emailEnc                   String? // encrypted
  phoneEnc                   String? // encrypted
  nationalRegistrationEnc    String? // encrypted
  // ---- Blind indexes (keyed HMAC-SHA256): one-way, for equality search only.
  // They store NO searchable plaintext and cannot be reversed to the value.
  phoneHash String? // blindIndex(phone)
  emailHash String? // blindIndex(email)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems DarazOrderItem[]

  @@index([phoneHash])
  @@index([emailHash])
}

/// One physical unit (one row per unique Daraz orderItemId). Quantity is always
/// 1 per orderItemId; multi-unit orders are multiple rows. Holds the order,
/// tracking, shipping and billing snapshot; customer identity links to DarazCustomer.
model DarazOrderItem {
  id            String    @id @default(cuid())
  orderItemId   String    @unique // Daraz Order Item ID — the idempotency key + income join key
  orderNumber   String
  sellerSku     String?
  lazadaSku     String?
  itemName      String?
  variation     String?
  quantity      Int       @default(1)
  unitPrice     Float     @default(0)
  paidPrice     Float     @default(0)
  status        String?
  createTime    DateTime?
  deliveredDate DateTime?

  // tracking / logistics — CIPHERTEXT (AES-256-GCM), server-only decryption
  trackingCodeEnc     String?
  trackingUrlEnc      String?
  shippingProvider    String? // not PII — carrier name kept readable

  // shipping + billing snapshot — all CIPHERTEXT (AES-256-GCM)
  shippingNameEnc     String?
  shippingAddressEnc  String?
  shippingPhoneEnc    String?
  shippingCityEnc     String?
  shippingPostCodeEnc String?
  billingNameEnc      String?
  billingAddressEnc   String?
  billingPhoneEnc     String?
  billingCityEnc      String?
  shippingPhoneHash   String? // blindIndex for search

  customerId    String?
  customer      DarazCustomer?    @relation(fields: [customerId], references: [id])
  productId     String? // resolved ledger Product (via DarazSkuMapping); null until mapped
  product       Product?          @relation(fields: [productId], references: [id])
  importBatchId String?
  importBatch   DarazImportBatch? @relation(fields: [importBatchId], references: [id])
  // One order item can appear in MORE THAN ONE weekly statement (e.g. a returned
  // item settled across two statements), so this is one-to-many, not one-to-one.
  incomeLines   DarazIncomeLine[]

  createdAt DateTime @default(now())

  @@index([orderNumber])
  @@index([sellerSku])
  @@index([customerId])
  @@index([productId])
}

/// One income line per (orderItemId, statementNumber) — a statement-specific
/// settlement line. The SAME Order Item ID can appear in two different weekly
/// statements (four such cases in the verified data), so identity is COMPOSITE:
/// (orderItemId, statementNumber). Daraz income is authoritative for
/// revenue/fees/refunds/reversals. Fees hang off the correct statement line.
model DarazIncomeLine {
  id                  String   @id @default(cuid())
  orderItemId         String // join key to DarazOrderItem.orderItemId
  statementNumber     String // part of the composite identity — always present
  orderNumber         String?
  sellerSku           String?
  productName         String?
  statementPeriod     String?
  transactionDate     DateTime?
  orderCreationDate   DateTime?
  orderStatus         String?
  releaseStatus       String?
  productPriceRevenue Float    @default(0)
  buyerShippingCredit Float    @default(0)
  totalCredits        Float    @default(0)
  totalDeductions     Float    @default(0)
  netAmount           Float    @default(0) // Daraz-authoritative net for this statement line
  reconciled          Boolean  @default(false)

  orderItem     DarazOrderItem    @relation(fields: [orderItemId], references: [orderItemId])
  importBatchId String?
  importBatch   DarazImportBatch? @relation(fields: [importBatchId], references: [id])
  fees          DarazIncomeFee[]

  createdAt DateTime @default(now())

  @@unique([orderItemId, statementNumber]) // composite identity + idempotency
  @@index([orderNumber])
  @@index([statementNumber])
  @@index([sellerSku])
}

/// Every original Daraz fee row, preserved verbatim (label + amount + VAT),
/// categorised without losing the label.
model DarazIncomeFee {
  id           String           @id @default(cuid())
  incomeLineId String
  incomeLine   DarazIncomeLine  @relation(fields: [incomeLineId], references: [id], onDelete: Cascade)
  label        String // ORIGINAL Daraz "Fee Name", verbatim
  category     DarazFeeCategory
  amount       Float
  vatAmount    Float            @default(0)
  isRefund     Boolean          @default(false)
  isReversal   Boolean          @default(false)

  @@index([incomeLineId])
  @@index([category])
}

/// Persistent Seller-SKU → ledger Product mapping. Created once, reused across
/// imports. Never auto-guessed from names — an operator sets it explicitly.
model DarazSkuMapping {
  id          String   @id @default(cuid())
  sellerSku   String   @unique
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  createdById String?
  createdBy   String?
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
}
